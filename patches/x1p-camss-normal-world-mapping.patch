Subject: [PATCH] media: camss: align X1P normal-world CSID and VFE resources

X1P currently reuses five X1E CSIDs with three VFEs. Parent acquisition,
register updates and buffer completion use the same array index, leaving
the lite CSIDs unable to acquire a parent and pairing full CSIDs with lite
VFEs.

Describe full0 and lite0 in matching order. The ASUS firmware assigns the
second lite window and its IRQs to SISP; do not expose that block through
the normal-world X1P map until its ownership has been established. This
conservative map deliberately uses only two of the three physical blocks.

Use lite CSID/RX clocks, omit full-CSID wrapper programming for X1P lite,
and advertise only the same-ID links supported by the update/done paths.
Keep other SoCs unchanged. This does not fix libcamera's independent
shortest-path selection and has not been tested on hardware.

Base commit: ebce72a408ccbfc5edaf3d63042a6abecbcebe33.

diff --git a/drivers/media/platform/qcom/camss/camss-csid-680.c b/drivers/media/platform/qcom/camss/camss-csid-680.c
--- a/drivers/media/platform/qcom/camss/camss-csid-680.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-680.c
@@ -214,6 +214,11 @@ static void __csid_configure_top(struct csid_device *csid)
 {
 	u32 val;
 
+	/* X1P lite CSIDs are local to the lite IFE, not the full wrapper. */
+	if (csid->camss->res->version == CAMSS_X1P42100 &&
+	    csid_is_lite(csid))
+		return;
+
 	val = CSID_TOP_IO_PATH_CFG0_OUTPUT_IFE_EN | CSID_TOP_IO_PATH_CFG0_INTERNAL_CSID;
 	writel(val, csid->camss->csid_wrapper_base +
 	    CSID_TOP_IO_PATH_CFG0(csid->id));
diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -4177,6 +4177,47 @@ static const struct camss_subdev_resources csiphy_res_x1p42100[] = {
 	},
 };
 
+/* Keep CSID indices aligned with their normal-world VFE parents. */
+static const struct camss_subdev_resources csid_res_x1p42100[] = {
+	/* CSID0 */
+	{
+		.clock = { "gcc_axi_hf", "gcc_axi_sf", "cpas_ahb",
+			   "cpas_fast_ahb", "csid", "csid_csiphy_rx" },
+		.clock_rate = { { 0 },
+				{ 0 },
+				{ 80000000 },
+				{ 80000000, 100000000, 200000000,
+				  300000000, 400000000 },
+				{ 300000000, 400000000 },
+				{ 300000000, 400000000 }, },
+		.reg = { "csid0" },
+		.interrupt = { "csid0" },
+		.csid = {
+			.hw_ops = &csid_ops_680,
+			.parent_dev_ops = &vfe_parent_dev_ops,
+			.formats = &csid_formats_gen2
+		},
+	},
+	/* CSID_LITE0; lite1 is assigned to SISP by the firmware. */
+	{
+		.clock = { "gcc_axi_hf", "gcc_axi_sf", "cpas_ahb",
+			   "vfe_lite_csid", "vfe_lite_cphy_rx" },
+		.clock_rate = { { 0 },
+				{ 0 },
+				{ 80000000 },
+				{ 266666667, 400000000 },
+				{ 300000000, 400000000 }, },
+		.reg = { "csid_lite0" },
+		.interrupt = { "csid_lite0" },
+		.csid = {
+			.is_lite = true,
+			.hw_ops = &csid_ops_680,
+			.parent_dev_ops = &vfe_parent_dev_ops,
+			.formats = &csid_formats_gen2
+		},
+	},
+};
+
 static const struct camss_subdev_resources vfe_res_x1p42100[] = {
 	/* IFE0 */
 	{
@@ -4225,29 +4266,6 @@ static const struct camss_subdev_resources vfe_res_x1p42100[] = {
 			.formats_pix = &vfe_formats_pix_845
 		},
 	},
-	/* IFE_LITE_1 */
-	{
-		.regulators = {},
-		.clock = { "camnoc_rt_axi", "camnoc_nrt_axi", "cpas_ahb",
-			   "vfe_lite_ahb", "cpas_vfe_lite", "vfe_lite",
-			   "vfe_lite_csid" },
-		.clock_rate = { { 400000000 },
-				{ 0 },
-				{ 0 },
-				{ 0 },
-				{ 0 },
-				{ 266666667, 400000000 },
-				{ 266666667, 400000000 }, },
-		.reg = { "vfe_lite1" },
-		.interrupt = { "vfe_lite1" },
-		.vfe = {
-			.is_lite = true,
-			.line_num = 4,
-			.hw_ops = &vfe_ops_680,
-			.formats_rdi = &vfe_formats_rdi_845,
-			.formats_pix = &vfe_formats_pix_845
-		},
-	},
 };
 
 /*
@@ -4753,6 +4771,11 @@ static int camss_link_entities(struct camss *camss)
 					struct v4l2_subdev *csid = &camss->csid[i].subdev;
 					struct v4l2_subdev *vfe = &camss->vfe[k].line[j].subdev;
 
+					/* Update and completion use the same CSID/VFE ID. */
+					if (camss->res->version == CAMSS_X1P42100 &&
+					    i != k)
+						continue;
+
 					ret = media_create_pad_link(&csid->entity,
 								    MSM_CSID_PAD_FIRST_SRC + j,
 								    &vfe->entity,
@@ -5459,13 +5482,13 @@ static const struct camss_resources x1p42100_resources = {
 	.version = CAMSS_X1P42100,
 	.pd_name = "top",
 	.csiphy_res = csiphy_res_x1p42100,
-	.csid_res = csid_res_x1e80100,
+	.csid_res = csid_res_x1p42100,
 	.vfe_res = vfe_res_x1p42100,
 	.csid_wrapper_res = &csid_wrapper_res_x1e80100,
 	.icc_res = icc_res_x1e80100,
 	.icc_path_num = ARRAY_SIZE(icc_res_x1e80100),
 	.csiphy_num = ARRAY_SIZE(csiphy_res_x1p42100),
-	.csid_num = ARRAY_SIZE(csid_res_x1e80100),
+	.csid_num = ARRAY_SIZE(csid_res_x1p42100),
 	.vfe_num = ARRAY_SIZE(vfe_res_x1p42100),
 };
 

diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -5805,6 +5805,20 @@
+static ssize_t facelock_capability_show(struct device *dev,
+                                       struct device_attribute *attr, char *buf)
+{
+	struct camss *camss = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s\n", camss->res->version == CAMSS_X1P42100 ?
+			  "x1p-normal-world-v1" : "unsupported");
+}
+static DEVICE_ATTR_RO(facelock_capability);
+static struct attribute *facelock_attrs[] = {
+	&dev_attr_facelock_capability.attr, NULL,
+};
+ATTRIBUTE_GROUPS(facelock);
 static struct platform_driver qcom_camss_driver = {
 	.probe = camss_probe,
 	.remove = camss_remove,
 	.driver = {
+		.dev_groups = facelock_groups,
 		.name = "qcom-camss",
 		.of_match_table = camss_dt_match,
