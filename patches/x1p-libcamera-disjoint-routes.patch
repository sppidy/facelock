+void SimplePipelineHandler::invalidatePeerConfigurations(SimpleCameraData *data)
+{
+	/* Shared fallback routes may be configured while neither camera runs. */
+	for (const SimpleCameraData::Entity &entity : data->entities_) {
+		for (SimpleCameraData *peer : entities_.at(entity.entity).users) {
+			if (peer != data)
+				peer->configurationValid_ = false;
+		}
+	}
+}
+
+bool SimplePipelineHandler::pipelineBusy(SimpleCameraData *data) const
+{
+	if (!disjointRoutes_)
+		return false;
+
+	for (const SimpleCameraData::Entity &entity : data->entities_) {
+		auto iter = entities_.find(entity.entity);
+		if (iter == entities_.end())
+			continue;
+
+		for (const auto &[pad, owner] : iter->second.owners) {
+			if (owner != data &&
+			    (!entity.supportsRouting || pad == entity.sink ||
+			     pad == entity.source))
+				return true;
+		}
+	}
+
+	return false;
+}
