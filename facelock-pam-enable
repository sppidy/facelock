#!/bin/sh
# facelock-pam-enable: wire face auth into PAM services (backs up first).
# Usage: sudo facelock-pam-enable login sudo [hyprlock ...]
# Entries are 'sufficient': password fallback always still works.
set -eu
PCHECK="${FACELOCK_PAM_CHECK:-/usr/lib/facelock/pam_check.sh}"
LINE="auth sufficient pam_exec.so $PCHECK"
[ $# -ge 1 ] || { echo "usage: $0 <service> [service...]"; exit 1; }
mkdir -p /etc/facelock/pam-backup
for svc in "$@"; do
  f="/etc/pam.d/$svc"
  [ -f "$f" ] || { echo "skip $svc (no $f)"; continue; }
  cp -n "$f" "/etc/facelock/pam-backup/$svc" || true
  if grep -qF "$LINE" "$f"; then echo "$svc: already wired"; continue; fi
  awk -v line="$LINE" 'NR==1{print; print line; next}1' "$f" > "$f.new"
  mv "$f.new" "$f"
  echo "$svc: wired (backup in /etc/facelock/pam-backup/$svc)"
done
echo "Test from a SECOND session before logging out."
