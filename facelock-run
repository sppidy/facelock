#!/bin/sh
# Clear inherited loader/Python/camera settings before starting the supervisor.
# FACELOCK_STAGED is a developer opt-in and is ignored for privileged runs.
set -eu
SELF=$(/usr/bin/readlink -f "$0")
DIR=${SELF%/*}
LIBDIR="$DIR/../lib/facelock"
if [ -f "$DIR/runner.py" ]; then LIBDIR="$DIR"; fi
exec /usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 \
  PAM_USER="${PAM_USER:-}" PAM_TYPE="${PAM_TYPE:-}" PAM_SERVICE="${PAM_SERVICE:-}" \
  SUDO_USER="${SUDO_USER:-}" FACELOCK_STAGED="${FACELOCK_STAGED:-}" \
  /usr/bin/python3 -I "$LIBDIR/runner.py" "$@"
